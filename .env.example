# =============================================================================
# Lever API Configuration
# =============================================================================
# Get your API key from: https://hire.lever.co/settings/integrations/api
LEVER_API_KEY=your_lever_api_key_here

# Environment: sandbox | production
# Request sandbox access: https://hire.lever.co/developer/sandbox
LEVER_ENVIRONMENT=sandbox

# =============================================================================
# LinkedIn API Configuration
# =============================================================================
# Create an app at: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Environment: development | production
LINKEDIN_ENVIRONMENT=development

# =============================================================================
# Application Configuration
# =============================================================================
# Environment: development | staging | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable LinkedIn integration (disable if API access unavailable)
ENABLE_LINKEDIN_INTEGRATION=true

# Enable advanced validators (Phase 2+)
ENABLE_ADVANCED_VALIDATORS=false

# Enable debug mode (additional logging, not for production)
DEBUG_MODE=true

# =============================================================================
# Rate Limiting
# =============================================================================
# Max requests per second to Lever API
LEVER_RATE_LIMIT=10

# Max requests per second to LinkedIn API
LINKEDIN_RATE_LIMIT=5

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
# For local development with Docker:
DATABASE_URL=postgresql+asyncpg://applicant_validator:dev_password_change_me@localhost:5432/applicant_validator

# Connection pool settings
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Docker PostgreSQL settings (used by docker-compose)
POSTGRES_USER=applicant_validator
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=applicant_validator
POSTGRES_PORT=5432

# =============================================================================
# pgAdmin (Optional - for database management UI)
# =============================================================================
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# =============================================================================
# Redis Cache (Future)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL_SECONDS=3600
